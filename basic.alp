										<ClassName><![CDATA[Truck]]></ClassName>
									</ActiveObjectClass>
									<GenericParameterSubstitute>
										<GenericParameterSubstituteReference>
											<PackageName><![CDATA[project]]></PackageName>
											<ClassName><![CDATA[Truck]]></ClassName>
