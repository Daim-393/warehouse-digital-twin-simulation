							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;

// 목적지 노드 배열 정의 (Main 에이전트의 Node 객체를 사용한다고 가정)
Node[] bulkDocks = {node3, node7, node9, node15, node16, node19};

// 4개의 노드 중 하나를 무작위로 선택합니다 (0부터 5까지의 인덱스).
// AnyLogic 표준 함수: uniform_discr(최소값, 최대값)
Node destination = bulkDocks[uniform_discr(0, 5)]; // 0, 1, 2, 3, 4, 5 중 하나를 선택

// 선택된 도크로 이동을 지시합니다.
t.moveTo(destination);]]></Code>
							</Value>
