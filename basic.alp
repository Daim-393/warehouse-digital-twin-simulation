						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[agent.inTime = time();   // 시스템 진입 시각 기록

// 1단계: 도크 vs 벌크 (dockRatio = 도크 비율, 예: 0.8 또는 0.6)
double rMode = uniform(0, 1);
if (rMode < dockRatio) {
    agent.mode = 1;      // 도크용
} else {
    agent.mode = 2;      // 벌크용
}

// 2단계: 세부 타입 설정 + 로딩시간 설정
if (agent.mode == 1) {
    // 도크용: 루즈백 15%, 팔렛 85%
    double rDock = uniform(0, 1);
    if (rDock < 0.15) {
        agent.dockProduct = 1;     // 루즈백
        agent.loadingTime = triangular(40, 55, 85);  // 60분
    } else {
        agent.dockProduct = 2;     // 팔렛
        agent.loadingTime = triangular(35, 50, 65);  // 50분
    }

} else {
    // 벌크용: Sea 70%, Tank 30%
    double rBulk = uniform(0, 1);
    if (rBulk < 0.7) {
        agent.bulkType = 1;        // Sea bulk
    } else {
        agent.bulkType = 2;        // Tank bulk
    }
    agent.loadingTime = triangular(30, 45, 75);      // 벌크 로딩시간은 공통 50분
}

Truck t = (Truck)agent;
t.moveTo( node1 );]]></Code>
							</Value>
						</Parameter>
